# このファイルをコピーして .env を作る（.env はコミットしない）
#   Copy-Item .env.example .env

# API のベース URL。Vite dev サーバが /api を VITE_PROXY_TARGET へプロキシする
VITE_API_BASE_URL=/api

# Vite dev サーバのプロキシ転送先。**必須**。
# バックエンドは別リポジトリ・別サーバで動くため、既定は「ホスト側の 8000 番」を指す。
#   - ホスト(Windows)でバックエンドを動かす      … http://host.docker.internal:8000
#   - 別サーバのバックエンドを叩く                … http://<ホスト名 or IP>:8000
#   - 同じ Docker ネットワークに載せる            … http://<サービス名>:8000
# host.docker.internal は Docker Desktop (Windows / macOS) で解決できる。
# Linux の Docker Engine 向けには docker-compose.yml の frontend に
# extra_hosts: ["host.docker.internal:host-gateway"] を入れてある。
# 未設定でも同じ既定値にフォールバックするが、起動時に警告が出る。
VITE_PROXY_TARGET=http://host.docker.internal:8000

# 操作者社員コード。更新系（POST / PUT / DELETE）で必須の X-User-Code ヘッダに載る。
# 本来は Onegate SSO のセッションから決まる値だが、認証がまだ実装されていないための暫定。
# 未設定だとヘッダを送らず、実 API の更新系が 422 で弾かれる（一覧・詳細は読める）。
# SSO が入ったら src/api/client.js の interceptor ごと差し替える。
#
# GET /auth/me もこの値で操作者を決めるので、書き換えると権限（サイドメニューの区分）が切り替わる。
# 反映には docker compose restart frontend とブラウザの再読み込みが要る。
#   MSW 有効時  admin      管理責任者  全区分が見える（権限マスタも編集可）
#               manager01  管理者      全区分が見える（権限マスタは閲覧のみ）
#               sales01    営業員      マスタメンテ・運用管理が消える
#               ifa01      IFA         マスタメンテ・運用管理が消える（発注権限も無い）
#               それ以外   管理責任者
#   実 API     操作者マスタにあるコードだけが有効。初期データは SYSTEM / admin（どちらも管理責任者）の 2 件。
#               マスタに無いコードは未登録（権限なし）になり、マスタメンテ・運用管理が消える。
#               ほかのロールを試すには、バックエンドの操作者マスタに行を足す。
# MSW 版の E2E は管理責任者を前提にしているので、E2E を回す前は admin に戻す。
VITE_USER_CODE=admin

# 開発サーバ実行時の MSW の ON/OFF。既定は有効で、false のときだけ無効になる。
# ハンドラ未定義のリクエストは実 API へ素通しされるため、
# API が実装されたら handlers から該当ハンドラを消すだけで本物に切り替わる。
# 実 API のみで動作確認したいときは false にする。
# ※ 本番ビルド(vite build)には MSW は一切含まれない。
VITE_ENABLE_MSW=true

# dev サーバをホストに公開するポート（docker-compose.yml の frontend が読む）。
# VITE_ ではないので Vite/アプリ側からは見えない。compose の変数補間専用。
# 本体リポジトリは未設定（既定 5173）のままでよい。worktree では
# scripts/worktree.sh add が 5174〜5199 の空きを割り当てて .env に追記する。
# コンテナ内のポートは常に 5173 なので、E2E の http://frontend:5173 は変わらない。
# FRONTEND_PORT=5173
