# dependencies
node_modules/

# build output
dist/

# Vite の依存事前バンドルキャッシュ
.vite/

# env（.env.example のみコミットする）
.env
.env.*
!.env.example

# 生成物（docker compose run --rm redocly build-docs で再生成できる）
docs/api/openapi.html

# test artifacts
test-results/
playwright-report/
blob-report/
coverage/
.vitest/

# Playwright MCP の出力（スクリーンショット等・調査用の一時ファイル）
.playwright-mcp/

# Claude Code の個人設定（承認モードなど。共有しない）
.claude/settings.local.json

# editor / OS
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
Thumbs.db
Desktop.ini
.DS_Store

# logs
*.log
npm-debug.log*
