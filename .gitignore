# dependencies
node_modules/

# build output
dist/

# Vite の依存事前バンドルキャッシュ
.vite/

# env（.env.example のみコミットする）
.env
.env.*
!.env.example

# 生成物（docker compose run --rm redocly build-docs で再生成できる）
# openapi.json は取り込んだ仕様そのもの（フロント実装上の正）なのでコミットする
docs/api/openapi.html

# test artifacts
test-results/
playwright-report/
blob-report/
coverage/
.vitest/

# Playwright MCP の出力（スクリーンショット等・調査用の一時ファイル）
.playwright-mcp/

# Claude Code の個人設定（承認モードなど。共有しない）
.claude/settings.local.json

# worktree ごとのローカル指示（scripts/worktree.sh add が生成する。共有しない）
CLAUDE.local.md

# 稼働中セッションのロック（session-worktree-notice.sh が同居検知に使う。共有しない）
.claude/.sessions/

# editor / OS
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
Thumbs.db
Desktop.ini
.DS_Store

# logs
*.log
npm-debug.log*
