{
  "mcpServers": {
    "playwright": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "--init",
        "--network",
        "us-stock-order_default",
        "-v",
        "./.playwright-mcp:/output",
        "mcr.microsoft.com/playwright/mcp",
        "--output-dir",
        "/output",
        "--save-session"
      ]
    }
  }
}
