{
  "mcpServers": {
    "playwright": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "--init",
        "--network",
        "us-stock-order-frontend_default",
        "-v",
        "./.playwright-mcp:/output",
        "mcr.microsoft.com/playwright/mcp",
        "--output-dir",
        "/output",
        "--save-session"
      ]
    },
    "chrome-devtools": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "--init",
        "--network",
        "us-stock-order-frontend_default",
        "us-stock-order-chrome-devtools-mcp",
        "--headless",
        "--isolated",
        "--chromeArg=--no-sandbox",
        "--viewport",
        "1280x720",
        "--no-page-id-routing",
        "--no-usage-statistics"
      ]
    }
  }
}
